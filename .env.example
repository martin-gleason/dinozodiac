# Copy to .env and fill in. .env is gitignored; never commit real credentials.
# Read by Python (python-dotenv) and R (readRenviron in R/db.R).
DZ_DB_HOST=localhost
DZ_DB_PORT=5432
DZ_DB_NAME=dinozodiac
DZ_DB_USER=postgres
DZ_DB_PASSWORD=change-me

# Python environment that has TensorFlow (created by keras3::install_keras()).
DZ_KERAS_ENV=r-keras
